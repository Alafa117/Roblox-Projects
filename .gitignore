# ===================================
# ROBLOX STUDIO FILES
# ===================================
# Project place files (binarios grandes)
*.rbxl
*.rbxlx
*.rbxm
*.rbxmx

# Roblox Studio lock files
*.rbxl.lock
*.rbxlx.lock

# ===================================
# ROJO
# ===================================
# Sourcemap generado por Rojo (SOLO si lo regeneras cada vez)
# Comentado: algunos equipos lo versionan para debugging
# sourcemap.json

# Caché de Rojo
.rojo/

# ❌ NO IGNORAR: default.project.json (necesario para el proyecto)

# ===================================
# WALLY (Package Manager)
# ===================================
# Paquetes instalados (se regeneran con 'wally install')
Packages/
ServerPackages/
DevPackages/

# ❌ NO IGNORAR: wally.lock (necesario para reproducibilidad)
# El lockfile asegura que todos usen las mismas versiones de dependencias

# ===================================
# ROKIT (Toolchain Manager)
# ===================================
# Solo ignorar binarios descargados, NO la configuración (rokit.toml)
.rokit/bin/
.rokit/cache/

# ===================================
# SISTEMA OPERATIVO
# ===================================
# Windows
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
*.stackdump

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Linux
*~
.directory

# ===================================
# IDE / EDITORES
# ===================================
# VS Code
.vscode/settings.json
.vscode/launch.json
.vscode/*.code-workspace

# JetBrains (IntelliJ, etc.)
.idea/
*.iml

# Sublime Text
*.sublime-project
*.sublime-workspace

# ===================================
# NODE.JS (si usas herramientas npm)
# ===================================
node_modules/
package-lock.json
yarn.lock

# ===================================
# TEMPORALES Y LOGS
# ===================================
*.log
*.tmp
*.temp
*.cache
*.bak
*.swp
*.swo
*~

# ===================================
# BUILDS Y OUTPUTS
# ===================================
/build/
/dist/
/out/

# ===================================
# TESTING
# ===================================
/coverage/
*.test.lua.snap

# ROBLOX ESPECÍFICO
# ===================================
# Assets temporales de Studio
*.mesh
*.anim

# Exports de modelos (si son grandes)
# *.fbx
# *.obj

# ===================================
# OTROS
# ===================================
# Archivos temporales o borradores (NO todos los .md)
*.draft.md
*.temp.md

# Archivos de respaldo
*_backup.*
*.backup

# Variables de entorno (si usas)
.env
.env.locald
*.temp.md